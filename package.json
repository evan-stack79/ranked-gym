{
  "name": "ranked-gym",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "pages:deploy": "wrangler pages deploy dist --project-name=ranked-gym",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:cloudflare": "npm run build && npm run deploy",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "brand:native": "npm run brand:assets && npx capacitor-assets generate --ios && npx capacitor-assets generate --android",
    "agents:check": "node scripts/agent-team-check.mjs",
    "agents:mission": "node scripts/agent-team.mjs mission",
    "agents:status": "node scripts/agent-team.mjs status"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@supabase/supabase-js": "^2.112.3",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "wrangler": "4.125.0"
  }
}
