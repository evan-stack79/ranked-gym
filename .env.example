# Google Maps / Places API
VITE_GOOGLE_MAPS_API_KEY=

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Gemini (Edge Function secrets — PAS dans le client) :
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GEMINI_MODEL=gemini-2.5-flash   # optionnel
#   + SUPABASE_SERVICE_ROLE_KEY déjà fourni par la plateforme
# Deploy function :
#   supabase functions deploy analyze-meal-photo
# Migration quotas :
#   supabase/migrations/20260821190000_ai_usage_limits.sql

# URL HTTPS publique de l’app (PWA / web) — utilisée pour les liens email
# (reset mot de passe). À autoriser aussi dans Supabase → Authentication →
# URL Configuration (Redirect URLs). Ex. : https://ton-app.pages.dev
# Sur Capacitor natif, laisser vide pour utiliser le Site URL Supabase
# (ne jamais mettre capacitor://localhost ici).
VITE_PUBLIC_APP_URL=

# Prototype BPM caméra (Profil → Réglages). false par défaut.
# Analyse PPG 100 % native (iOS AVFoundation / Android CameraX). Aucune persistance.
# VITE_ENABLE_CAMERA_HEART_RATE=true

# ---------------------------------------------------------------------------
# Convex (Phase A scaffold — names only, leave empty)
# Supabase remains the default runtime until an explicit cutover.
# See docs/CONVEX_SETUP.md and docs/migrations/supabase-to-convex-plan.md §10.
# ---------------------------------------------------------------------------

# Client / Vite (build-time)
VITE_CONVEX_URL=
# Leave false/empty. Domain services still use Supabase in Phase A.
VITE_ENABLE_CONVEX_PRIMARY=false
# Dedicated flag for PR-E auth migration. Keep false until Convex auth validation.
VITE_ENABLE_CONVEX_AUTH=false
# Already documented above for password-reset links; reused by Convex later.
# VITE_PUBLIC_APP_URL=

# Convex CLI / backend (never put secrets in git; local .env.local only)
# CONVEX_DEPLOYMENT=
# CONVEX_DEPLOY_KEY=
# CONVEX_AUTH_SECRET=
# CONVEX_AUTH_EMAIL_FROM=
# CONVEX_AUTH_RESET_REDIRECT_URL=
# CONVEX_AUTH_RESET_TOKEN_TTL_MIN=
# CONVEX_AUTH_SESSION_TTL_HOURS=
# CONVEX_FILE_SIGNED_URL_TTL_SEC=

# Migration scripts (later phase — runtime env only, never commit values)
# MIGRATION_SUPABASE_URL=
# MIGRATION_SUPABASE_SERVICE_ROLE_KEY=
# MIGRATION_CONVEX_URL=
# MIGRATION_CONVEX_ADMIN_KEY=
# MIGRATION_RUN_ID=

